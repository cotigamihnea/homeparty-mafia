{
  "name": "mafia-party-app",
  "version": "1.1.1",
  "description": "A local multiplayer Mafia party game",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron .",
    "package": "tsc && electron-builder --win"
  },
  "build": {
    "appId": "com.homeparty.mafia",
    "productName": "Mafia Party Game",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*.html",
      "src/renderer/**/*.css",
      "src/renderer/assets/**/*",
      "src/client/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "express": "^4.21.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@32.3.3": true
  }
}
